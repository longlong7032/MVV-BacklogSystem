{
  // Server (Node.js): server.ts, lib/, mcp/, scripts/  ->  biên dịch ra dist/
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["server.ts", "lib/**/*.ts", "mcp/**/*.ts", "scripts/**/*.ts", "shared/**/*.d.ts"]
}
