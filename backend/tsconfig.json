{
  // Backend (Node.js): src/  ->  biên dịch ra dist/
  "compilerOptions": {
    "target": "ES2022",
    "strict": true, // bật toàn bộ kiểm tra chặt (noImplicitAny, strictNullChecks, ...)
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleDetection": "force", // mọi file đều là module
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
