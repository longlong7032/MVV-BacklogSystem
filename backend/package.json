{
  "name": "feedback-backlog-backend",
  "version": "2.0.0",
  "description": "Feedback backlog — Backend: REST API, MCP, lưu trữ (Postgres / file JSON, R2). TypeScript + Express.",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "migrate-to-pg": "tsx src/scripts/migrate-to-pg.ts",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
