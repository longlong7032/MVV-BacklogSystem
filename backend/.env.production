# Cấu hình Feedback backlog — file này chứa bí mật, KHÔNG commit (đã có trong .gitignore)

PORT=3000

# Số proxy phía trước app. 0 = chạy trực tiếp (local); 1 = sau nginx / load balancer.
TRUST_PROXY=1

# Địa chỉ công khai của FRONTEND (dùng dựng link ảnh / HAR trong MCP, vì ảnh được phục vụ qua frontend). Bỏ trống = tự lấy theo request.
# PUBLIC_URL=https://backlog.congty.vn

# Ép toàn server chỉ đọc qua MCP (bỏ qua quyền từng người dùng).
MCP_READONLY=1

# CHỈ để thử local: bỏ xác thực trang Người dùng và /mcp. KHÔNG bật khi deploy.
# DEV_NO_AUTH=1

# Admin cứng (không bắt buộc): mỗi lần khởi động đảm bảo tài khoản này là admin có đúng mật khẩu (tối thiểu 8 ký tự).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# Neon Postgres (Neon Console -> Connection Details; chọn "Pooled connection" khi chạy serverless): có biến này thì lưu dữ liệu + ảnh vào Postgres, không có thì lưu file local (data/, uploads/).
# Khi chạy local ĐỂ TRỐNG để không đụng dữ liệu production; chỉ đặt trong Environment Variables của Vercel.
DATABASE_URL=postgresql://neondb_owner:npg_bM6wExlUme5i@ep-purple-star-a16sjlc9-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Cloudflare R2 (ảnh + file HAR). Cần đủ cả 4 biến mới bật; thiếu một biến thì ảnh lưu như cũ (Postgres / thư mục uploads).
#  R2_ACCOUNT_ID         : Cloudflare Dashboard -> R2 -> Account ID
#  R2_ACCESS_KEY_ID,
#  R2_SECRET_ACCESS_KEY  : R2 -> Manage API Tokens -> Create API token (quyền Object Read & Write)
#  R2_BUCKET             : tên bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY= https://0f2b91c94f84987dac08b3a1d84d1a39.r2.cloudflarestorage.com/backlog-manage-system
R2_BUCKET=
