# Cấu hình Feedback backlog — file này chứa bí mật, KHÔNG commit (đã có trong .gitignore)

PORT=3000

# Số proxy phía trước app. 0 = chạy trực tiếp (local); 1 = sau nginx / load balancer.
TRUST_PROXY=1

# Địa chỉ công khai của FRONTEND (dùng dựng link ảnh / HAR trong MCP, vì ảnh được phục vụ qua frontend). Bỏ trống = tự lấy theo request.
# PUBLIC_URL=https://backlog.congty.vn

# Ép toàn server chỉ đọc qua MCP (bỏ qua quyền từng người dùng).
# MCP_READONLY=1

# CHỈ để thử local: bỏ xác thực trang Người dùng và /mcp. KHÔNG bật khi deploy.
# DEV_NO_AUTH=1

# Admin cứng (không bắt buộc): mỗi lần khởi động đảm bảo tài khoản này là admin có đúng mật khẩu (tối thiểu 8 ký tự).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# Postgres (BẮT BUỘC). Local: `docker compose up -d` ở thư mục gốc rồi dùng dòng dưới.
# Production (Neon Console -> Connection Details, chọn "Pooled connection"): đặt trong Environment Variables của Vercel, KHÔNG ghi vào file này.
DATABASE_URL=postgresql://feedback:feedback@localhost:5433/feedback

# Cloudflare R2 (ảnh + file HAR). Cần đủ cả 4 biến mới bật; thiếu một biến thì file lưu trong bảng `files` của Postgres.
#  R2_ACCOUNT_ID         : Cloudflare Dashboard -> R2 -> Account ID
#  R2_ACCESS_KEY_ID,
#  R2_SECRET_ACCESS_KEY  : R2 -> Manage API Tokens -> Create API token (quyền Object Read & Write)
#  R2_BUCKET             : tên bucket
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
