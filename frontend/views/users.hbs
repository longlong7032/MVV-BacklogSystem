<section>
{{> page_header title="Người dùng & token" subtitle="Quản lý tài khoản quản trị, quyền MCP và token cá nhân."}}
{{#if (eq state "locked")}}
  <!-- Đăng nhập quản trị bằng token cá nhân -->
  <div class="card mx-auto max-w-md border border-base-content/10 bg-base-100 shadow-sm"><div class="card-body">
    <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-base-200">
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/></svg>
    </div>
    <h2 class="text-base font-semibold">Khu vực quản trị</h2>
    <p id="usersLockText" class="mt-1 text-sm text-base-content/70">Đăng nhập quản trị viên để quản lý người dùng và token.</p>
    <form id="adminKeyForm" data-login class="mt-4 space-y-3" novalidate>
      <div id="loginPasswordFields" class="space-y-3">
        <input id="adminEmail" name="email" type="email" autocomplete="username" inputmode="email" placeholder="Email quản trị"
          class="input input-bordered w-full">
        <input id="adminPassword" name="password" type="password" autocomplete="current-password" placeholder="Mật khẩu"
          class="input input-bordered w-full">
      </div>
      <div id="loginTokenFields" class="hidden">
        <input id="adminKey" name="token" type="password" autocomplete="off" placeholder="Token quản trị (fbk_…)"
          class="input input-bordered w-full">
      </div>
      <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
      <button type="submit" data-submit class="btn btn-primary btn-sm btn-block">Đăng nhập</button>
      <button type="button" data-login-mode class="btn btn-link btn-sm btn-block">Đăng nhập bằng token cá nhân</button>
    </form>
  </div></div>

{{/if}}
{{#if (eq state "disabled")}}
  <!-- Module bị tắt -->
  <div role="alert" class="alert mx-auto max-w-xl flex-col items-start text-sm">
    <p class="font-semibold">Chưa có quản trị viên nào</p>
    <p class="mt-1">Cách 1: đặt <code class="kbd kbd-sm">ADMIN_EMAIL</code> và <code class="kbd kbd-sm">ADMIN_PASSWORD</code> (tối thiểu 8 ký tự) trong file <code class="kbd kbd-sm">.env</code> rồi khởi động lại server — tài khoản admin được tạo tự động.</p>
    <p class="mt-3">Cách 2: chạy lệnh sau trên máy chủ chứa ứng dụng, lệnh in ra một token cá nhân:</p>
    <div class="mockup-code w-full text-sm"><pre data-prefix="$"><code>npm run create-admin -- "Họ tên" email@congty.vn</code></pre></div>
    <p class="mt-3">Sau khi đăng nhập, bạn tạo thêm admin và người dùng khác ngay trên giao diện.</p>
    <a href="/users" data-retry class="btn btn-primary btn-sm mt-1">Tôi đã tạo, tải lại</a>
  </div>

{{/if}}
{{#if (eq state "ok")}}
  <div class="card border border-base-content/10 bg-base-100 shadow-sm">
    <div class="flex flex-wrap items-center gap-3 border-b border-base-content/10 p-4">
      {{> search_box action="/users" q=q placeholder="Tìm tên, email..."}}
      <p class="text-sm text-base-content/70">{{summary}}</p>
      <div class="flex gap-2 sm:ml-auto">
        <button type="button" data-logout class="btn btn-sm">Đăng xuất</button>
        <button type="button" data-open-form="user"
          class="btn btn-primary btn-sm"><span aria-hidden="true">+</span> Thêm người dùng
        </button>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="table w-full min-w-[1000px] table-fixed">
        <colgroup>
          <col>
          <col class="w-28">
          <col class="w-36">
          <col class="w-60">
          <col class="w-28">
          <col class="w-64">
        </colgroup>
        <thead>
          <tr>
            <th>Người dùng</th>
            <th>Quyền MCP</th>
            <th>Team</th>
            <th>Token</th>
            <th>Trạng thái</th>
            <th class="text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr data-item="{{json item}}" class="align-top hover">
            <td>
              <p class="break-words font-medium">{{name}}</p>
              <p class="break-all text-base-content/70">{{email}}</p>
            </td>
            <td><span class="badge {{roleClass}}">{{roleLabel}}</span></td>
            <td>{{#if teamName}}{{teamName}}{{else}}{{> dash}}{{/if}}</td>
            <td>
              {{#if hasToken}}<code class="kbd kbd-sm">{{tokenHint}}</code>{{else}}{{> dash}}{{/if}}
              <p class="mt-1 text-sm text-base-content/50">{{#if hasToken}}Cấp {{fmtDate tokenCreatedAt}} · {{#if lastUsedAt}}dùng {{timeAgo lastUsedAt}}{{else}}chưa dùng{{/if}}{{else}}Cần cấp token để kết nối{{/if}}</p>
            </td>
            <td><span class="badge {{statusClass}}">{{statusLabel}}</span></td>
            <td>
              <div class="flex flex-wrap justify-end gap-1">
                <button type="button" data-act="edit" class="btn btn-ghost btn-xs">Sửa</button>
                <button type="button" data-act="token" data-id="{{id}}" data-name="{{name}}" data-has-token="{{hasToken}}" class="btn btn-ghost btn-xs">{{#if hasToken}}Cấp lại token{{else}}Cấp token{{/if}}</button>
                {{#if hasToken}}<button type="button" data-act="revoke" data-id="{{id}}" data-name="{{name}}" class="btn btn-ghost btn-xs text-error">Thu hồi</button>{{/if}}
                <button type="button" data-act="delete" data-id="{{id}}" data-resource="users" data-label="người dùng &quot;{{name}}&quot;" data-warn="Token của họ sẽ mất hiệu lực." class="btn btn-ghost btn-xs text-error">Xóa</button>
              </div>
            </td>
          </tr>
          {{else}}{{> table_message colspan=6 message=empty}}{{/each}}
        </tbody>
      </table>
    </div>

    <details class="collapse collapse-arrow rounded-none border-t border-base-content/10">
      <summary class="collapse-title text-sm font-semibold">Nhật ký hoạt động quản trị</summary>
      <div class="collapse-content overflow-x-auto px-0">
        <table class="table w-full min-w-[640px]">
          <thead>
            <tr><th class="w-44">Thời gian</th><th class="w-44">Người thực hiện</th><th>Hành động</th><th class="w-48">Đối tượng</th></tr>
          </thead>
          <tbody>
            {{#each audit}}
            <tr class="align-top">
              <td class="text-base-content/70">{{dateTime createdAt}}</td>
              <td class="font-medium">{{actor}}</td>
              <td>{{action}}</td>
              <td>{{target}}</td>
            </tr>
            {{else}}<tr><td colspan="4" class="py-8 text-center text-base-content/70">Chưa có hoạt động nào.</td></tr>{{/each}}
          </tbody>
        </table>
      </div>
    </details>
  </div>
{{/if}}
</section>

{{#if (eq state "ok")}}
{{> modal_user}}
{{/if}}
