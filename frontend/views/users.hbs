<section>
{{#if (eq state "locked")}}
  <!-- Đăng nhập quản trị bằng token cá nhân -->
  <div class="mx-auto max-w-md rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/></svg>
    </div>
    <h2 class="text-base font-semibold text-slate-900">Khu vực quản trị</h2>
    <p id="usersLockText" class="mt-1 text-sm text-slate-600">Đăng nhập quản trị viên để quản lý người dùng và token.</p>
    <form id="adminKeyForm" data-login class="mt-4 space-y-3" novalidate>
      <div id="loginPasswordFields" class="space-y-3">
        <input id="adminEmail" name="email" type="email" autocomplete="username" inputmode="email" placeholder="Email quản trị"
          class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm">
        <input id="adminPassword" name="password" type="password" autocomplete="current-password" placeholder="Mật khẩu"
          class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm">
      </div>
      <div id="loginTokenFields" class="hidden">
        <input id="adminKey" name="token" type="password" autocomplete="off" placeholder="Token quản trị (fbk_…)"
          class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm">
      </div>
      <p data-error class="hidden rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"></p>
      <button type="submit" data-submit class="w-full rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60">Đăng nhập</button>
      <button type="button" data-login-mode class="w-full text-center text-sm font-medium text-indigo-600 hover:text-indigo-800">Đăng nhập bằng token cá nhân</button>
    </form>
  </div>

{{/if}}
{{#if (eq state "disabled")}}
  <!-- Module bị tắt -->
  <div class="mx-auto max-w-xl rounded-lg border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
    <p class="font-semibold">Chưa có quản trị viên nào</p>
    <p class="mt-1">Cách 1: đặt <code class="rounded bg-white/70 px-1.5 py-0.5">ADMIN_EMAIL</code> và <code class="rounded bg-white/70 px-1.5 py-0.5">ADMIN_PASSWORD</code> (tối thiểu 8 ký tự) trong file <code class="rounded bg-white/70 px-1.5 py-0.5">.env</code> rồi khởi động lại server — tài khoản admin được tạo tự động.</p>
    <p class="mt-3">Cách 2: chạy lệnh sau trên máy chủ chứa ứng dụng, lệnh in ra một token cá nhân:</p>
    <pre class="mt-3 overflow-x-auto rounded-md bg-slate-900 p-3 text-xs text-slate-100"><code>npm run create-admin -- "Họ tên" email@congty.vn</code></pre>
    <p class="mt-3">Sau khi đăng nhập, bạn tạo thêm admin và người dùng khác ngay trên giao diện.</p>
    <a href="/users" data-retry class="mt-4 inline-block rounded-md border border-amber-300 bg-white px-3 py-1.5 text-sm font-medium text-amber-900 hover:bg-amber-100">Tôi đã tạo, tải lại</a>
  </div>

{{/if}}
{{#if (eq state "ok")}}
  <div class="rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-wrap items-center gap-3 border-b border-slate-200 px-4 py-4">
      <form method="get" action="/users" data-autosubmit class="w-full sm:w-auto">
        <input name="q" value="{{q}}" type="search" placeholder="Tìm tên, email..."
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:w-60">
      </form>
      <p class="text-sm text-slate-500">{{summary}}</p>
      <div class="flex gap-2 sm:ml-auto">
        <button type="button" data-logout class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Đăng xuất</button>
        <button type="button" data-open-form="user"
          class="inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300">
          <span aria-hidden="true" class="text-base leading-none">+</span> Thêm người dùng
        </button>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[1000px] table-fixed border-collapse text-left text-sm">
        <colgroup>
          <col>
          <col class="w-28">
          <col class="w-36">
          <col class="w-60">
          <col class="w-28">
          <col class="w-64">
        </colgroup>
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-3 py-3 font-semibold">Người dùng</th>
            <th class="px-3 py-3 font-semibold">Quyền MCP</th>
            <th class="px-3 py-3 font-semibold">Team</th>
            <th class="px-3 py-3 font-semibold">Token</th>
            <th class="px-3 py-3 font-semibold">Trạng thái</th>
            <th class="px-3 py-3 text-right font-semibold">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {{#each rows}}
          <tr data-item="{{json item}}" class="align-top hover:bg-slate-50">
            <td class="px-3 py-3">
              <p class="break-words font-medium text-slate-900">{{name}}</p>
              <p class="break-all text-slate-500">{{email}}</p>
            </td>
            <td class="px-3 py-3"><span class="rounded-md px-2 py-1 text-xs font-medium {{roleClass}}">{{roleLabel}}</span></td>
            <td class="px-3 py-3 text-slate-700">{{#if teamName}}{{teamName}}{{else}}{{> dash}}{{/if}}</td>
            <td class="px-3 py-3">
              {{#if hasToken}}<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-700">{{tokenHint}}</code>{{else}}{{> dash}}{{/if}}
              <p class="mt-1 text-xs text-slate-400">{{#if hasToken}}Cấp {{fmtDate tokenCreatedAt}} · {{#if lastUsedAt}}dùng {{timeAgo lastUsedAt}}{{else}}chưa dùng{{/if}}{{else}}Cần cấp token để kết nối{{/if}}</p>
            </td>
            <td class="px-3 py-3"><span class="rounded-full px-2.5 py-1 text-xs font-medium {{statusClass}}">{{statusLabel}}</span></td>
            <td class="px-3 py-3">
              <div class="flex flex-wrap justify-end gap-1">
                <button type="button" data-act="edit" class="rounded px-2 py-1 text-xs font-medium text-slate-600 hover:bg-slate-100">Sửa</button>
                <button type="button" data-act="token" data-id="{{id}}" data-name="{{name}}" data-has-token="{{hasToken}}" class="rounded px-2 py-1 text-xs font-medium text-indigo-600 hover:bg-indigo-50">{{#if hasToken}}Cấp lại token{{else}}Cấp token{{/if}}</button>
                {{#if hasToken}}<button type="button" data-act="revoke" data-id="{{id}}" data-name="{{name}}" class="rounded px-2 py-1 text-xs font-medium text-amber-700 hover:bg-amber-50">Thu hồi</button>{{/if}}
                <button type="button" data-act="delete" data-id="{{id}}" data-resource="users" data-label="người dùng &quot;{{name}}&quot;" data-warn="Token của họ sẽ mất hiệu lực." class="rounded px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-50">Xóa</button>
              </div>
            </td>
          </tr>
          {{else}}{{> table_message colspan=6 message=empty}}{{/each}}
        </tbody>
      </table>
    </div>

    <details class="border-t border-slate-200">
      <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900">Nhật ký hoạt động quản trị</summary>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr><th class="w-44 px-4 py-2 font-semibold">Thời gian</th><th class="w-44 px-4 py-2 font-semibold">Người thực hiện</th><th class="px-4 py-2 font-semibold">Hành động</th><th class="w-48 px-4 py-2 font-semibold">Đối tượng</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {{#each audit}}
            <tr class="align-top">
              <td class="px-4 py-2 text-slate-500">{{dateTime at}}</td>
              <td class="px-4 py-2 font-medium text-slate-800">{{actor}}</td>
              <td class="px-4 py-2 text-slate-700">{{action}}</td>
              <td class="px-4 py-2 text-slate-700">{{target}}</td>
            </tr>
            {{else}}<tr><td colspan="4" class="px-4 py-6 text-center text-slate-500">Chưa có hoạt động nào.</td></tr>{{/each}}
          </tbody>
        </table>
      </div>
    </details>
  </div>
{{/if}}
</section>

{{#if (eq state "ok")}}
{{> modal_user}}
{{/if}}
