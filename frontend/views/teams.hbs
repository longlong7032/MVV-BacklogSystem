<section>
  {{#> page_header title="Team xử lý" extra=summary subtitle="Các team nhận và xử lý backlog."}}
    <button type="button" data-open-form="team" class="btn btn-primary btn-sm"><span aria-hidden="true">+</span> Thêm team</button>
  {{/page_header}}
  <div class="card border border-base-content/10 bg-base-100 shadow-sm">
    <div class="border-b border-base-content/10 p-4">{{> search_box action="/teams" q=q placeholder="Tìm team..."}}</div>
    <div class="overflow-x-auto">
      <table class="table w-full min-w-[860px] table-fixed">
        <colgroup>
          <col>
          <col class="w-44">
          <col class="w-72">
          <col class="w-52">
        </colgroup>
        <thead>
          <tr>
            <th>Team</th>
            <th>Trưởng nhóm</th>
            <th>Khối lượng backlog</th>
            <th class="text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr data-item="{{json item}}" class="align-top hover">
            <td>
              <p class="break-words font-medium">{{name}}</p>
              {{#if description}}<p class="mt-1 whitespace-pre-wrap break-words text-base-content/70">{{description}}</p>{{/if}}
            </td>
            <td class="break-words">{{#if lead}}{{lead}}{{else}}{{> dash}}{{/if}}</td>
            <td>{{> progress progress}}</td>
            <td>
              <div class="flex justify-end gap-1">
                <a href="{{backlogHref}}" class="btn btn-ghost btn-xs">Xem backlog</a>
                <button type="button" data-act="edit" class="btn btn-ghost btn-xs">Sửa</button>
                <button type="button" data-act="delete" data-id="{{idPublic}}" data-resource="teams" data-label="team &quot;{{name}}&quot;" data-warn="Các backlog đang giao cho team này sẽ chuyển về &quot;Chưa phân công&quot; (backlog không bị xóa)." class="btn btn-ghost btn-xs text-error">Xóa</button>
              </div>
            </td>
          </tr>
          {{else}}{{> table_message colspan=4 message=empty}}{{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>


{{> modal_team}}
