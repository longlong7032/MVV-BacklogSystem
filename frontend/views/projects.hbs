<section>
  {{#> page_header title="Dự án" extra=summary subtitle="Không gian làm việc tập trung cho từng dự án."}}
    <button type="button" data-open-form="project" class="btn btn-primary btn-sm"><span aria-hidden="true">+</span> Tạo dự án</button>
  {{/page_header}}
  <div class="mb-4">{{> search_box action="/projects" q=q placeholder="Tìm theo tên hoặc mã dự án"}}</div>
  <div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
    {{#each rows}}
    <article data-item="{{json item}}" class="card group overflow-hidden border border-base-content/10 bg-base-100 shadow-sm transition hover:shadow-md">
      <a href="{{detailHref}}" class="block p-5">
        <div class="flex items-start justify-between gap-3">
          <div class="flex min-w-0 items-center gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-box bg-base-200 text-lg font-bold">{{initial}}</span>
            <div class="min-w-0"><div class="flex flex-wrap items-center gap-2">{{#if code}}<span class="badge badge-ghost tracking-wide">{{code}}</span>{{/if}}{{#if overdue}}<span class="badge badge-error badge-outline">Trễ deadline</span>{{/if}}<span class="text-sm text-base-content/50">{{memberCount}} nhân sự</span></div><h3 class="mt-1 truncate text-base font-semibold">{{name}}</h3></div>
          </div><span class="text-base-content/50 transition group-hover:translate-x-0.5 group-hover:text-base-content/70">→</span>
        </div>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-sm text-base-content/70"><span>{{#if startDate}}Bắt đầu {{fmtDate startDate}}{{else}}Chưa đặt ngày bắt đầu{{/if}}</span><span class="font-medium {{#if overdue}}text-error{{/if}}">{{#if deadline}}Deadline {{deadlineLabel}}{{else}}Chưa đặt deadline{{/if}}</span></div>
        <p class="mt-2 line-clamp-2 min-h-10 text-sm leading-5 text-base-content/70">{{#if description}}{{description}}{{else}}Theo dõi tiến độ và nhân sự dự án.{{/if}}</p>
        <div class="mt-5 grid grid-cols-3 divide-x divide-base-content/10 rounded-box bg-base-200 py-3 text-center">
          <div><p class="text-lg font-semibold">{{total}}</p><p class="text-sm text-base-content/70">Tổng việc</p></div><div><p class="text-lg font-semibold">{{doing}}</p><p class="text-sm text-base-content/70">Đang làm</p></div><div><p class="text-lg font-semibold">{{done}}</p><p class="text-sm text-base-content/70">Hoàn thành</p></div>
        </div>
        <div class="mt-4">{{> progress progress}}</div>
      </a>
      <div class="flex items-center justify-between border-t border-base-content/10 px-5 py-3">
        <a href="{{detailHref}}" class="link link-hover text-sm font-semibold">Mở không gian dự án <span aria-hidden="true">→</span></a>
        <div class="flex gap-1"><button type="button" data-act="edit" data-form="project" class="btn btn-ghost btn-xs">Sửa</button><button type="button" data-act="delete" data-id="{{idPublic}}" data-resource="projects" data-label="dự án &quot;{{name}}&quot;" data-warn="Toàn bộ backlog (kèm ảnh) của dự án này cũng sẽ bị xóa và không thể khôi phục." class="btn btn-ghost btn-xs text-error">Xóa</button></div>
      </div>
    </article>
    {{else}}
    {{> empty_state icon="⌂" title="Chưa có dự án phù hợp" text=../empty}}
    {{/each}}
  </div>
</section>
{{> modal_project}}
