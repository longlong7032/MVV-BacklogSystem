<article draggable="true" data-card="{{id}}" data-item="{{json item}}" class="cursor-grab rounded-md border border-slate-200 bg-white p-3 shadow-sm hover:shadow active:cursor-grabbing">
  <div class="flex items-center justify-between gap-2 text-xs">
    <span class="truncate font-medium text-slate-700">{{projectLabel}} · #{{stt}}</span>
    <button type="button" data-act="edit" class="shrink-0 font-medium text-indigo-600 hover:text-indigo-800">Sửa</button>
  </div>
  {{#if type}}<span class="mt-2 inline-block max-w-full truncate rounded bg-sky-50 px-1.5 py-0.5 text-xs font-medium text-sky-700">{{type}}</span>{{/if}}
  {{#if title}}<p class="mt-2 line-clamp-2 break-words text-sm font-semibold text-slate-900">{{title}}</p>{{/if}}
  <p class="mt-1 line-clamp-3 whitespace-pre-wrap break-words text-sm text-slate-700">{{#if bugText}}{{bugText}}{{else}}<span class="text-slate-400">(không có mô tả)</span>{{/if}}</p>
  {{#if image}}<img src="{{image}}" data-zoom="{{image}}" alt="" loading="lazy" class="mt-2 h-24 w-full cursor-zoom-in rounded border border-slate-200 object-cover">{{/if}}
  <div class="mt-3 flex items-center justify-between gap-2 text-xs text-slate-500">
    {{#if teamName}}<span class="truncate rounded bg-indigo-50 px-1.5 py-0.5 font-medium text-indigo-700">{{teamName}}</span>{{else}}<span class="text-slate-400">Chưa phân công</span>{{/if}}
    <span class="shrink-0">{{timeAgo updatedAt}}</span>
  </div>
</article>
