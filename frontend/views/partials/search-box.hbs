{{!-- Ô tìm kiếm GET tự gửi khi gõ. Tham số: action, q, placeholder. --}}
<form method="get" action="{{action}}" data-autosubmit class="w-full sm:w-72">
  <label class="input input-bordered input-sm flex items-center gap-2">
    <svg class="h-4 w-4 shrink-0 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd"/></svg>
    <input name="q" value="{{q}}" type="search" placeholder="{{placeholder}}" class="grow" autocomplete="off">
  </label>
</form>
