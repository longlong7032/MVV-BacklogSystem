{{!-- Lưới ảnh trong màn hình chi tiết backlog. Tham số: images (mảng URL), alt. Nền trắng để ảnh PNG trong suốt vẫn rõ ở giao diện tối. --}}
{{#if images.length}}
<div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
  {{#each images}}
  <button type="button" data-zoom="{{this}}" class="group relative block aspect-[4/3] overflow-hidden rounded-btn border border-base-content/10 bg-white" title="Bấm để phóng to">
    <img src="{{this}}" data-zoom="{{this}}" alt="{{../alt}} {{@index}}" loading="lazy" class="h-full w-full cursor-zoom-in object-contain transition group-hover:scale-[1.03]">
  </button>
  {{/each}}
</div>
{{/if}}
