<!-- Form thêm / sửa team -->
<div id="teamModal" data-modal class="modal" role="dialog" aria-modal="true">
  <form id="teamForm" class="modal-box w-full max-w-lg p-0" novalidate>
    <div class="flex items-center justify-between border-b border-base-content/10 px-5 py-4">
      <h2 data-title class="text-base font-semibold">Thêm team</h2>
      <button type="button" data-close class="btn btn-ghost btn-sm btn-square" aria-label="Đóng">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 0 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
      </button>
    </div>
    <div class="space-y-4 px-5 py-5">
      <div>
        <label for="tName" class="mb-1 block text-sm font-medium">Tên team</label>
        <input id="tName" name="name" maxlength="120" autocomplete="off" required class="input input-bordered w-full">
      </div>
      <div>
        <label for="tLead" class="mb-1 block text-sm font-medium">Trưởng nhóm <span class="font-normal text-base-content/70">(không bắt buộc)</span></label>
        <input id="tLead" name="lead" maxlength="120" autocomplete="off" class="input input-bordered w-full">
      </div>
      <div>
        <label for="tDescription" class="mb-1 block text-sm font-medium">Mô tả <span class="font-normal text-base-content/70">(không bắt buộc)</span></label>
        <textarea id="tDescription" name="description" rows="3" class="textarea textarea-bordered w-full"></textarea>
      </div>
      <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
    </div>
    <div class="flex items-center justify-end gap-2 border-t border-base-content/10 bg-base-200 px-5 py-3">
      <button type="button" data-close class="btn btn-sm">Hủy</button>
      <button type="submit" data-submit class="btn btn-primary btn-sm">Lưu team</button>
    </div>
  </form>
</div>
