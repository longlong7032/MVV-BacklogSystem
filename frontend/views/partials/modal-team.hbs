<!-- Form thêm / sửa team -->
<div id="teamModal" data-modal class="fixed inset-0 z-[45] hidden items-start justify-center overflow-y-auto bg-slate-900/50 p-4">
  <form id="teamForm" class="my-16 w-full max-w-lg rounded-lg bg-white shadow-xl" novalidate>
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
      <h2 data-title class="text-base font-semibold text-slate-900">Thêm team</h2>
      <button type="button" data-close class="rounded p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Đóng">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 0 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
      </button>
    </div>
    <div class="space-y-4 px-5 py-5">
      <div>
        <label for="tName" class="mb-1 block text-sm font-medium text-slate-700">Tên team</label>
        <input id="tName" name="name" maxlength="120" autocomplete="off" required class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
      </div>
      <div>
        <label for="tLead" class="mb-1 block text-sm font-medium text-slate-700">Trưởng nhóm <span class="font-normal text-slate-500">(không bắt buộc)</span></label>
        <input id="tLead" name="lead" maxlength="120" autocomplete="off" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
      </div>
      <div>
        <label for="tDescription" class="mb-1 block text-sm font-medium text-slate-700">Mô tả <span class="font-normal text-slate-500">(không bắt buộc)</span></label>
        <textarea id="tDescription" name="description" rows="3" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"></textarea>
      </div>
      <p data-error class="hidden rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"></p>
    </div>
    <div class="flex items-center justify-end gap-2 border-t border-slate-200 bg-slate-50 px-5 py-3">
      <button type="button" data-close class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Hủy</button>
      <button type="submit" data-submit class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60">Lưu team</button>
    </div>
  </form>
</div>
