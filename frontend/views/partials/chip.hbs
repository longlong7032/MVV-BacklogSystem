{{!-- Nút chọn dạng "chip" (loại / team / trạng thái trong form backlog). JS bật aria-pressed cho chip đang chọn. --}}
<button type="button" {{attr}}="{{value}}" aria-pressed="false" class="btn btn-sm {{extra}} whitespace-nowrap rounded-full border-base-content/20 bg-base-100 font-normal shadow-none hover:border-base-content/40 hover:bg-base-200 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:font-medium aria-pressed:text-primary-content">{{label}}</button>
