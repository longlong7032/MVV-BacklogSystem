{{!-- Form thêm / sửa tài liệu PTYC. Context = documentsModel(). Thêm mới: kèm file + phiên bản đầu; sửa: chỉ thông tin chung (+ nút Xóa). --}}
<div id="documentModal" data-modal class="modal" role="dialog" aria-modal="true">
  <form id="documentForm" class="modal-box flex max-h-[92dvh] w-full max-w-xl flex-col overflow-hidden p-0" novalidate>
    <div class="flex shrink-0 items-center justify-between border-b border-base-content/10 px-5 py-4">
      <h2 data-title class="text-base font-semibold">Tải tài liệu PTYC</h2>
      <button type="button" data-close class="btn btn-ghost btn-sm btn-square" aria-label="Đóng">✕</button>
    </div>
    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-5">
      <div data-create-only>
        <label for="dProject" class="mb-1 block text-sm font-medium">Dự án</label>
        <select id="dProject" name="project_id" class="select select-bordered w-full"><option value="">— Chọn dự án —</option>{{> options options=form.projects}}</select>
      </div>
      <div>
        <label for="dTitle" class="mb-1 block text-sm font-medium">Tên tài liệu</label>
        <input id="dTitle" name="title" maxlength="200" required autocomplete="off" placeholder="vd PTYC Website truyện tranh" class="input input-bordered w-full">
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="dType" class="mb-1 block text-sm font-medium">Loại tài liệu</label>
          <input id="dType" name="doc_type" list="docTypeList" maxlength="60" autocomplete="off" placeholder="Chọn hoặc nhập" class="input input-bordered w-full">
          <datalist id="docTypeList">{{#each form.docTypes}}<option value="{{this}}"></option>{{/each}}</datalist>
        </div>
        <div>
          <label for="dStatus" class="mb-1 block text-sm font-medium">Trạng thái</label>
          <select id="dStatus" name="status" class="select select-bordered w-full">{{#each form.statuses}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
        </div>
      </div>
      <div>
        <label for="dNote" class="mb-1 block text-sm font-medium">Ghi chú <span class="font-normal text-base-content/60">(không bắt buộc)</span></label>
        <textarea id="dNote" name="note" rows="2" maxlength="2000" class="textarea textarea-bordered w-full"></textarea>
      </div>
      <fieldset data-create-only class="rounded-box border border-base-content/10 p-4">
        <legend class="px-1 text-sm font-medium">File tài liệu (phiên bản đầu tiên)</legend>
        <input name="document_file" type="file" class="file-input file-input-bordered file-input-sm w-full" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.md,.png,.jpg,.jpeg,.webp,.zip">
        <p class="mt-1 text-xs text-base-content/60">PDF, Word, Excel, PowerPoint, ảnh hoặc zip.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-[8rem_1fr]">
          <input name="version" maxlength="30" placeholder="v1.0" class="input input-bordered input-sm w-full" aria-label="Tên phiên bản">
          <input name="version_note" maxlength="1000" placeholder="Ghi chú phiên bản (không bắt buộc)" class="input input-bordered input-sm w-full" aria-label="Ghi chú phiên bản">
        </div>
      </fieldset>
      <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
    </div>
    <div class="flex shrink-0 items-center justify-end gap-2 border-t border-base-content/10 bg-base-200 px-5 py-3">
      <button type="button" data-doc-delete data-act="delete" data-resource="documents" class="btn btn-ghost btn-sm mr-auto hidden text-error">Xóa</button>
      <button type="button" data-close class="btn btn-sm">Hủy</button>
      <button type="submit" data-submit class="btn btn-primary btn-sm">Tải lên</button>
    </div>
  </form>
</div>
