<!-- Form thêm / sửa backlog (mobile-first: bottom sheet, thanh nút luôn hiện) -->
<div id="modal" data-modal class="modal modal-bottom sm:modal-middle" role="dialog" aria-modal="true">
  <form id="form" data-next-stt="{{form.nextStt}}" data-current-project="{{form.currentProject}}" data-current-team="{{form.currentTeam}}" data-projects="{{form.projectsJson}}" class="modal-box flex max-h-[95dvh] w-full max-w-2xl flex-col overflow-hidden p-0 sm:max-h-[92vh] md:max-w-5xl" novalidate>
    <div class="flex shrink-0 items-center justify-between border-b border-base-content/10 px-4 py-3 sm:px-5 sm:py-4">
      <h2 id="modalTitle" class="text-base font-semibold">Thêm backlog</h2>
      <button type="button" data-close class="btn btn-ghost btn-sm btn-square -mr-2" aria-label="Đóng">
        <svg class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 0 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-4 sm:px-5 sm:py-5">
     <!-- Mobile: phân loại ở trên (thu gọn được); desktop: nội dung bên trái, phân loại & giao việc cố định bên phải -->
     <div class="flex flex-col gap-4 md:grid md:grid-cols-[minmax(0,1fr)_19rem] md:items-start md:gap-6">

      <!-- Phân loại: thu gọn khi đã nhớ lựa chọn lần trước -->
      <details id="fMeta" class="group rounded-box border border-base-content/10 bg-base-100 md:sticky md:top-0 md:order-2 md:bg-base-200/50">
        <summary class="flex cursor-pointer list-none items-center [&::-webkit-details-marker]:hidden justify-between gap-3 px-3 py-3 md:hidden">
          <span id="metaSummary" class="line-clamp-2 min-w-0 flex-1 break-words text-sm font-medium"></span>
          <span class="btn btn-ghost btn-xs shrink-0 group-open:hidden">Đổi</span>
          <span class="btn btn-ghost btn-xs hidden shrink-0 group-open:inline-flex">Thu gọn</span>
        </summary>
        <p class="hidden px-3 pt-3 text-xs font-semibold uppercase tracking-wide text-base-content/60 md:block">Phân loại &amp; giao việc</p>
        <div class="space-y-4 border-t border-base-content/10 px-3 py-4 md:border-t-0 md:pt-2">
          <div>
            <label for="fProject" class="mb-1 block text-sm font-medium">Dự án</label>
            <select id="fProject" name="project_id" required
              class="select select-bordered w-full"><option value="">— Chọn dự án —</option>{{> options options=form.projects}}</select>
            <p id="sttHint" class="mt-1 text-sm text-base-content/70">STT được tự động đánh số theo từng dự án.</p>
          </div>

          <div>
            <p class="mb-1 text-sm font-medium">Loại <span class="font-normal text-base-content/60">(vai trò trong dự án)</span></p>
            <div id="typeChips" class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1 empty:hidden md:flex-wrap md:overflow-visible"></div>
            <p id="typeHint" class="hidden text-sm text-base-content/60"></p>
            <input type="hidden" id="fType" name="type">
          </div>

          <div>
            <label for="fTeam" class="mb-1 block text-sm font-medium">Team xử lý</label>
            <select id="fTeam" name="team_id" class="select select-bordered w-full"><option value="">— Chưa phân công —</option>{{#each form.teams}}<option value="{{idPublic}}">{{name}}</option>{{/each}}</select>
          </div>

          <div>
            <label for="fAssignee" class="mb-1 block text-sm font-medium">Người trực tiếp xử lý</label>
            <select id="fAssignee" name="assignee_id" class="select select-bordered w-full"><option value="">— Chưa giao người xử lý —</option>{{#each form.members}}<option value="{{idPublic}}">{{name}}</option>{{/each}}</select>
          </div>

          <div>
            <p class="mb-1 text-sm font-medium">Trạng thái</p>
            <div id="statusChips" class="grid grid-cols-3 gap-2 md:grid-cols-1">{{#each form.statuses}}{{> chip attr="data-chip-status" value=key label=label extra="!rounded-lg"}}{{/each}}</div>
            <select id="fStatus" name="status" class="hidden" tabindex="-1" aria-hidden="true">{{#each form.statuses}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
          </div>
        </div>
      </details>

      <div class="space-y-4 md:order-1">
      <div>
        <label for="fTitle" class="mb-1 block text-sm font-medium">Tên lỗi</label>
        <input id="fTitle" name="title" maxlength="200" autocomplete="off" enterkeyhint="next" placeholder="Tóm tắt ngắn gọn lỗi"
          class="input input-bordered w-full">
      </div>

      <section data-zone="location" class="-m-2 rounded-box border border-transparent p-2">
        <label for="fLocationUrl" class="mb-1 block text-sm font-medium">Vị trí lỗi <span class="font-normal text-base-content/70">(URL hoặc ảnh)</span></label>
        <input id="fLocationUrl" name="location_url" type="text" inputmode="url" placeholder="https://..." autocomplete="off" autocapitalize="off"
          class="input input-bordered w-full">
        <div data-dropzone="location" class="rounded-box mt-2 flex flex-wrap items-center gap-2 border border-dashed border-base-content/10 bg-base-200 p-2">
          <button type="button" data-pick="location" class="btn btn-sm">
            <span aria-hidden="true">📷</span> Thêm ảnh
          </button>
          <span class="hidden text-sm text-base-content/70 sm:inline">hoặc kéo thả / dán ảnh (Ctrl+V)</span>
          <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="hidden" data-input="location">
          <div data-preview="location" class="flex w-full flex-wrap gap-2 empty:hidden"></div>
        </div>
        <div id="fHarBox" class="mt-2 hidden items-center justify-between gap-3 px-3 py-2 text-sm rounded-box border border-base-content/10 bg-base-100">
          <a id="fHarLink" href="#" download class="link link-hover truncate underline"></a>
          <label class="flex shrink-0 items-center gap-1.5 text-base-content/70">
            <input type="checkbox" id="fRemoveHar" class="checkbox checkbox-sm w-4"> Gỡ HAR
          </label>
        </div>
        <div class="rounded-box mt-2 flex flex-wrap items-center gap-2 border border-dashed border-base-content/10 bg-base-200 p-2">
          <button type="button" id="fHarPick" class="btn btn-sm">
            <span aria-hidden="true">📎</span> Thêm file HAR
          </button>
          <span id="fHarHint" class="text-sm text-base-content/70">chưa chọn file (.har)</span>
          <button type="button" id="fHarClear" class="hidden text-sm font-medium">Bỏ</button>
          <input type="file" id="fHarInput" accept=".har,application/json" class="hidden">
        </div>
      </section>

      <section data-zone="bug" class="-m-2 rounded-box border border-transparent p-2">
        <label for="fBugText" class="mb-1 block text-sm font-medium">Mô tả lỗi <span class="font-normal text-base-content/70">(ảnh + text)</span></label>
        <textarea id="fBugText" name="bug_text" rows="3"
          class="textarea textarea-bordered w-full"></textarea>
        <div data-dropzone="bug" class="rounded-box mt-2 flex flex-wrap items-center gap-2 border border-dashed border-base-content/10 bg-base-200 p-2">
          <button type="button" data-pick="bug" class="btn btn-sm">
            <span aria-hidden="true">📷</span> Thêm ảnh
          </button>
          <span class="hidden text-sm text-base-content/70 sm:inline">hoặc kéo thả / dán ảnh (Ctrl+V)</span>
          <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple class="hidden" data-input="bug">
          <div data-preview="bug" class="flex w-full flex-wrap gap-2 empty:hidden"></div>
        </div>
      </section>

      <section data-zone="expected" class="-m-2 rounded-box border border-transparent p-2">
        <label for="fExpectedText" class="mb-1 block text-sm font-medium">Kết quả mong muốn <span class="font-normal text-base-content/70">(ảnh + text)</span></label>
        <textarea id="fExpectedText" name="expected_text" rows="2"
          class="textarea textarea-bordered w-full"></textarea>
        <div data-dropzone="expected" class="rounded-box mt-2 flex flex-wrap items-center gap-2 border border-dashed border-base-content/10 bg-base-200 p-2">
          <button type="button" data-pick="expected" class="btn btn-sm">
            <span aria-hidden="true">📷</span> Thêm ảnh
          </button>
          <span class="hidden text-sm text-base-content/70 sm:inline">hoặc kéo thả / dán ảnh (Ctrl+V)</span>
          <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple class="hidden" data-input="expected">
          <div data-preview="expected" class="flex w-full flex-wrap gap-2 empty:hidden"></div>
        </div>
      </section>

      <details id="fNoteBox" class="group">
        <summary class="cursor-pointer list-none py-1 [&::-webkit-details-marker]:hidden text-sm font-medium group-open:hidden">+ Thêm ghi chú</summary>
        <label for="fNote" class="mb-1 block text-sm font-medium">Ghi chú <span class="font-normal text-base-content/70">(nếu có)</span></label>
        <textarea id="fNote" name="note_text" rows="2"
          class="textarea textarea-bordered w-full"></textarea>
      </details>

      </div>

      <p id="formError" role="alert" class="alert alert-error hidden py-2 text-sm md:order-3 md:col-span-2"></p>
     </div>
    </div>

    <!-- Thanh nút luôn hiển thị ở đáy -->
    <div class="flex shrink-0 gap-2 border-t border-base-content/10 bg-base-100 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:justify-end sm:bg-base-200 sm:px-5">
      <button id="btnSave" type="submit" class="btn btn-primary btn-sm order-3 flex-1 sm:flex-none">Lưu</button>
      <button id="btnSaveNew" type="submit" class="btn btn-sm order-2 flex-1 sm:flex-none">Lưu &amp; thêm tiếp</button>
      <button type="button" data-close class="btn btn-sm order-1 hidden sm:inline-flex">Hủy</button>
      <!-- Chỉ hiện khi sửa backlog có sẵn (JS gắn data-id / data-label) -->
      <button type="button" id="btnDeleteBacklog" data-act="delete" class="btn btn-ghost btn-sm order-0 hidden text-error sm:mr-auto">Xóa</button>
    </div>
  </form>
</div>

<!-- Mẫu ảnh xem trước (JS nhân bản, không tự dựng HTML) -->
<template id="tplPreview">
  <div class="relative h-20 w-20">
    <img src="" data-zoom="" alt="" class="h-20 w-20 cursor-zoom-in rounded-btn border border-base-content/10 object-cover">
    <button type="button" data-remove="" data-index="" aria-label="Xóa ảnh" class="btn btn-circle btn-neutral btn-xs absolute -right-2 -top-2">×</button>
  </div>
</template>

<!-- Mẫu chip "Loại" (JS nhân bản theo vai trò của dự án đang chọn) -->
<template id="tplTypeChip">{{> chip attr="data-chip-type" value="" label="" extra="shrink-0"}}</template>
