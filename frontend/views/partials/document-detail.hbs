{{!-- Nội dung chi tiết một tài liệu PTYC (render sẵn trong <template>, client sao chép vào modal). Context = một dòng của documentsModel(). --}}
<div data-detail-title class="hidden">{{title}}</div>
<dl class="grid grid-cols-2 gap-x-6 gap-y-3 rounded-box border border-base-content/10 p-4 text-sm sm:grid-cols-3">
  <div class="min-w-0"><dt class="text-xs text-base-content/60">Dự án</dt><dd class="truncate font-medium">{{projectLabel}}</dd></div>
  <div class="min-w-0"><dt class="text-xs text-base-content/60">Loại tài liệu</dt><dd class="truncate font-medium">{{#if docType}}{{docType}}{{else}}<span class="font-normal text-base-content/50">Chưa chọn</span>{{/if}}</dd></div>
  <div class="min-w-0"><dt class="text-xs text-base-content/60">Cập nhật</dt><dd class="truncate font-medium" title="{{dateTime updatedAt}}">{{timeAgo updatedAt}}</dd></div>
</dl>
{{#if note}}<p class="mt-3 whitespace-pre-wrap break-words rounded-box bg-base-200/60 p-3 text-sm">{{note}}</p>{{/if}}

<h3 class="mt-5 text-sm font-semibold">Phiên bản <span class="font-normal text-base-content/60">· {{versionCount}}</span></h3>
<ol class="mt-2 divide-y divide-base-content/10 rounded-box border border-base-content/10">
  {{#each versions}}
  <li class="flex flex-wrap items-center gap-3 px-4 py-3 text-sm">
    <span class="badge {{#if @first}}badge-primary{{else}}badge-ghost{{/if}} shrink-0">{{version}}</span>
    <div class="min-w-0 flex-1">
      <p class="truncate font-medium" title="{{file.name}}">{{file.name}} <span class="font-normal text-base-content/60">· {{sizeLabel}}</span></p>
      <p class="text-xs text-base-content/60">{{#if uploadedBy}}{{uploadedBy}} · {{/if}}{{dateTime createdAt}}{{#if note}} — {{note}}{{/if}}</p>
    </div>
    <a href="{{file.url}}" download="{{file.name}}" class="btn btn-ghost btn-sm shrink-0">⇩ Tải</a>
  </li>
  {{/each}}
</ol>
