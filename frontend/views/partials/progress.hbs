{{#if empty}}<span class="text-sm text-base-content/50">{{emptyText}}</span>{{else}}
<div class="flex items-center gap-2">
  <progress class="progress progress-primary flex-1" value="{{pct}}" max="100" aria-label="{{pct}}% hoàn thành"></progress>
  <span class="w-10 text-right text-sm font-medium text-base-content/70">{{pct}}%</span>
</div>
<p class="mt-1 text-sm text-base-content/70">{{done}}/{{total}} hoàn thành · {{todo}} chưa làm{{#if doing}} · {{doing}} đang làm{{/if}}</p>
{{/if}}
