<!-- Form thêm / sửa người dùng -->
<div id="userModal" data-modal class="modal" role="dialog" aria-modal="true">
  <form id="userForm" class="modal-box w-full max-w-lg p-0" novalidate>
    <div class="flex items-center justify-between border-b border-base-content/10 px-5 py-4">
      <h2 data-title class="text-base font-semibold">Thêm người dùng</h2>
      <button type="button" data-close class="btn btn-ghost btn-sm btn-square" aria-label="Đóng">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 0 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
      </button>
    </div>
    <div class="space-y-4 px-5 py-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="uName" class="mb-1 block text-sm font-medium">Họ tên</label>
          <input id="uName" name="name" maxlength="120" autocomplete="off" required class="input input-bordered w-full">
        </div>
        <div>
          <label for="uEmail" class="mb-1 block text-sm font-medium">Email</label>
          <input id="uEmail" name="email" type="email" maxlength="200" autocomplete="off" required class="input input-bordered w-full">
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="uRole" class="mb-1 block text-sm font-medium">Quyền MCP</label>
          <select id="uRole" name="role" class="select select-bordered w-full">
            <option value="read">Chỉ đọc</option>
            <option value="write">Đọc + ghi (đổi trạng thái, giao team)</option>
            <option value="admin">Quản trị viên (đọc + ghi + quản lý người dùng)</option>
          </select>
        </div>
        <div>
          <label for="uTeam" class="mb-1 block text-sm font-medium">Team <span class="font-normal text-base-content/70">(không bắt buộc)</span></label>
          <select id="uTeam" name="teamId" class="select select-bordered w-full">{{> options options=teamOptions}}</select>
        </div>
      </div>
      <label data-edit-only class="hidden items-center gap-2 text-sm">
        <input type="checkbox" id="uActive" name="active" class="checkbox checkbox-sm"> Tài khoản đang hoạt động (bỏ chọn để chặn kết nối)
      </label>
      <p data-create-only class="alert py-2 text-sm">Token cá nhân sẽ được tạo ngay sau khi lưu và chỉ hiển thị một lần.</p>
      <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
    </div>
    <div class="flex items-center justify-end gap-2 border-t border-base-content/10 bg-base-200 px-5 py-3">
      <button type="button" data-close class="btn btn-sm">Hủy</button>
      <button type="submit" data-submit class="btn btn-primary btn-sm">Lưu</button>
    </div>
  </form>
</div>

<!-- Hiển thị token (một lần) -->
<div id="tokenModal" data-modal data-modal-sticky class="modal" role="dialog" aria-modal="true">
  <div class="modal-box w-full max-w-2xl p-0">
    <div class="border-b border-base-content/10 px-5 py-4">
      <h2 class="text-base font-semibold">Token của <span data-token-user></span></h2>
    </div>
    <div class="space-y-4 px-5 py-5 text-sm text-base-content/70">
      <p role="alert" class="alert alert-warning py-2 text-sm"><b>Sao chép ngay.</b> Token chỉ hiển thị một lần này, hệ thống chỉ lưu bản băm nên không thể xem lại. Mất token thì phải cấp lại. Gửi riêng cho đúng người dùng, không đăng vào chat chung hay commit vào repo.</p>
      <div>
        <p class="mb-1 text-sm font-medium uppercase tracking-wide text-base-content/70">Token</p>
        <div class="join w-full">
          <code id="tokenValue" class="input input-bordered input-sm join-item flex h-auto min-h-8 min-w-0 flex-1 items-center break-all bg-base-200 py-1"></code>
          <button type="button" data-copy-target="#tokenValue" class="btn btn-sm join-item">Sao chép</button>
        </div>
      </div>
      <div>
        <p class="mb-1 text-sm font-medium uppercase tracking-wide text-base-content/70">Lệnh kết nối Claude Code</p>
        <div class="relative">
          <button type="button" data-copy-target="#tokenCmd" class="btn btn-xs absolute right-2 top-2">Sao chép</button>
          <pre class="overflow-x-auto rounded-btn bg-neutral p-4 pr-24 text-sm leading-relaxed text-neutral-content"><code id="tokenCmd"></code></pre>
        </div>
        <p class="mt-2 text-sm">Cấu hình cho Cursor, VS Code... xem trang <a href="/mcp-guide" class="link link-hover font-medium">Kết nối MCP</a>.</p>
      </div>
    </div>
    <div class="flex justify-end border-t border-base-content/10 bg-base-200 px-5 py-3">
      <button type="button" data-token-done class="btn btn-primary btn-sm">Tôi đã lưu token</button>
    </div>
  </div>
</div>
