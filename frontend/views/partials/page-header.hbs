{{!--
  Tiêu đề trang dùng chung. Tham số: title, subtitle?, eyebrow?, extra? (chữ phụ cạnh tiêu đề).
  Nút hành động truyền qua block:  {{#> page_header title="Dự án"}}<button class="btn btn-primary btn-sm">…</button>{{/page_header}}
--}}
<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
  <div class="min-w-0">
    {{#if eyebrow}}<p class="text-sm font-semibold uppercase tracking-wider text-base-content/60">{{eyebrow}}</p>{{/if}}
    <h1 class="text-2xl font-semibold tracking-tight">{{title}}{{#if extra}} <span class="text-base font-normal text-base-content/50">{{extra}}</span>{{/if}}</h1>
    {{#if subtitle}}<p class="mt-1 text-sm text-base-content/70">{{subtitle}}</p>{{/if}}
  </div>
  {{#if @partial-block}}<div class="flex flex-wrap items-center gap-2">{{> @partial-block}}</div>{{/if}}
</div>
