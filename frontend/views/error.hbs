{{!-- Trang lỗi dùng chung (vd không kết nối được backend). Tham số: heading, message, hint? --}}
<div class="mx-auto max-w-2xl">
  {{> page_header title=heading}}
  <div role="alert" class="alert alert-error items-start">
    <svg class="h-6 w-6 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
    <div>
      <p class="font-semibold">{{message}}</p>
      {{#if hint}}<p class="mt-1 text-sm">{{hint}}</p>{{/if}}
    </div>
  </div>
  <div class="mt-4"><a href="" class="btn btn-sm">Thử lại</a></div>
</div>
