{{!--
  Trang lỗi dùng chung (404 / 500 / mất kết nối backend) — render bằng renderError() trong src/pages/errors.ts.
  Tham số: status, heading, message, hint?, retry
--}}
<div class="mx-auto max-w-2xl py-6">
  <div class="card border border-base-content/10 bg-base-100 shadow-sm">
    <div class="card-body items-center text-center">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-error/15 text-2xl font-semibold text-error" aria-hidden="true">!</span>
      <p class="mt-2 text-sm font-semibold uppercase tracking-wider text-base-content/50">Lỗi {{status}}</p>
      <h1 class="text-2xl font-semibold tracking-tight">{{heading}}</h1>
      <p class="mt-1 max-w-lg break-words text-base-content/80">{{message}}</p>
      {{#if hint}}<p class="max-w-lg break-words text-sm text-base-content/60">{{hint}}</p>{{/if}}
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        {{#if retry}}<a href="" class="btn btn-primary btn-sm">Thử lại</a>{{/if}}
        <a href="/dashboard" class="btn btn-sm">Về tổng quan</a>
      </div>
    </div>
  </div>
</div>
