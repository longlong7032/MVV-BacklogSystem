<section>
{{> page_header title="Hồ sơ" subtitle="Thông tin tài khoản đang đăng nhập và đổi mật khẩu."}}
<div class="grid max-w-4xl gap-5 lg:grid-cols-2">

  <!-- Thông tin tài khoản -->
  <div class="card border border-base-content/10 bg-base-100 shadow-sm"><div class="card-body">
    <div class="flex items-center gap-3">
      <div class="avatar placeholder"><div class="w-12 rounded-full bg-primary text-primary-content"><span class="text-lg font-semibold">{{initial profile.name}}</span></div></div>
      <div class="min-w-0">
        <p class="truncate font-semibold" data-profile-name>{{profile.name}}</p>
        <p class="truncate text-sm text-base-content/70">{{profile.email}}</p>
      </div>
      <span class="badge badge-primary badge-outline ml-auto">{{roleLabel}}</span>
    </div>
    <form id="profileForm" class="mt-4 space-y-3" novalidate>
      <label class="form-control w-full">
        <span class="label-text mb-1 text-sm">Tên hiển thị</span>
        <input name="name" type="text" maxlength="120" value="{{profile.name}}" autocomplete="name" class="input input-bordered w-full">
      </label>
      <label class="form-control w-full">
        <span class="label-text mb-1 text-sm">Email đăng nhập</span>
        <input type="email" value="{{profile.email}}" disabled class="input input-bordered w-full">
      </label>
      <p class="text-sm text-base-content/60">Tạo ngày {{fmtDate profile.createdAt}}{{#if profile.lastUsedAt}} · hoạt động {{timeAgo profile.lastUsedAt}}{{/if}}</p>
      <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
      <button type="submit" data-submit class="btn btn-primary btn-sm">Lưu thay đổi</button>
    </form>
  </div></div>

  <!-- Đổi mật khẩu -->
  <div class="card border border-base-content/10 bg-base-100 shadow-sm"><div class="card-body">
    <h2 class="font-semibold">Đổi mật khẩu</h2>
    <p class="text-sm text-base-content/70">Sau khi đổi, các thiết bị khác sẽ bị đăng xuất.</p>
    <form id="passwordForm" class="mt-3 space-y-3" novalidate>
      <input type="text" name="username" value="{{profile.email}}" autocomplete="username" class="hidden" tabindex="-1" aria-hidden="true">
      {{#if profile.hasPassword}}
      <input name="current" type="password" autocomplete="current-password" placeholder="Mật khẩu hiện tại" class="input input-bordered w-full">
      {{/if}}
      <input name="next" type="password" autocomplete="new-password" placeholder="Mật khẩu mới (tối thiểu 8 ký tự)" class="input input-bordered w-full">
      <input name="confirm" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" class="input input-bordered w-full">
      <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
      <button type="submit" data-submit class="btn btn-primary btn-sm">Đổi mật khẩu</button>
    </form>
    <div class="divider my-2"></div>
    <button type="button" data-logout class="btn btn-outline btn-sm self-start">Đăng xuất</button>
  </div></div>

</div>
</section>
