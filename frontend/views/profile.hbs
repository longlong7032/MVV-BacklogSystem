<section class="mx-auto max-w-4xl">
{{> page_header title="Hồ sơ" subtitle="Quản lý thông tin tài khoản và bảo mật đăng nhập."}}

  <!-- Thẻ tổng quan tài khoản -->
  <div class="card mb-5 overflow-hidden border border-base-content/10 bg-base-100 shadow-sm">
    <div class="h-20 bg-gradient-to-r from-primary/30 via-primary/10 to-transparent"></div>
    <div class="flex flex-wrap items-end gap-4 px-6 pb-5">
      <div class="avatar placeholder -mt-10">
        <div class="w-20 rounded-full bg-primary text-primary-content ring-4 ring-base-100"><span class="text-3xl font-semibold">{{initial profile.name}}</span></div>
      </div>
      <div class="min-w-0 flex-1 pb-1">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="truncate text-xl font-semibold" data-profile-name>{{profile.name}}</h2>
          <span class="badge badge-primary badge-sm">{{roleLabel}}</span>
        </div>
        <p class="truncate text-sm text-base-content/70">{{profile.email}}</p>
      </div>
      <button type="button" data-logout class="btn btn-outline btn-sm mb-1">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 4a2 2 0 0 1 2-2h5a1 1 0 1 1 0 2H5v12h5a1 1 0 1 1 0 2H5a2 2 0 0 1-2-2V4Zm10.293 2.293a1 1 0 0 1 1.414 0l3 3a1 1 0 0 1 0 1.414l-3 3a1 1 0 0 1-1.414-1.414L14.586 11H8a1 1 0 1 1 0-2h6.586l-1.293-1.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"/></svg>
        Đăng xuất
      </button>
    </div>
    <dl class="grid grid-cols-2 gap-px border-t border-base-content/10 bg-base-content/10 text-sm sm:grid-cols-3">
      <div class="bg-base-100 px-6 py-3"><dt class="text-base-content/60">Ngày tạo</dt><dd class="font-medium">{{fmtDate profile.createdAt}}</dd></div>
      <div class="bg-base-100 px-6 py-3"><dt class="text-base-content/60">Hoạt động gần nhất</dt><dd class="font-medium">{{#if profile.lastUsedAt}}{{timeAgo profile.lastUsedAt}}{{else}}—{{/if}}</dd></div>
      <div class="col-span-2 bg-base-100 px-6 py-3 sm:col-span-1"><dt class="text-base-content/60">Đăng nhập bằng</dt><dd class="font-medium">{{#if profile.hasPassword}}Email &amp; mật khẩu{{else}}Token cá nhân{{/if}}</dd></div>
    </dl>
  </div>

  <div class="grid items-start gap-5 md:grid-cols-2">

    <!-- Thông tin -->
    <div class="card border border-base-content/10 bg-base-100 shadow-sm"><div class="card-body gap-4 p-6">
      <div>
        <h2 class="font-semibold">Thông tin cá nhân</h2>
        <p class="text-sm text-base-content/60">Tên hiển thị xuất hiện trong nhật ký hoạt động.</p>
      </div>
      <form id="profileForm" class="space-y-4" novalidate>
        <label class="form-control w-full gap-1">
          <span class="label-text font-medium">Tên hiển thị</span>
          <input name="name" type="text" maxlength="120" value="{{profile.name}}" autocomplete="name" class="input input-bordered w-full">
        </label>
        <label class="form-control w-full gap-1">
          <span class="label-text font-medium">Email đăng nhập</span>
          <input type="email" value="{{profile.email}}" disabled class="input input-bordered w-full">
          <span class="label-text-alt text-base-content/60">Email không thể thay đổi.</span>
        </label>
        <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
        <div class="flex justify-end"><button type="submit" data-submit class="btn btn-primary btn-sm">Lưu thay đổi</button></div>
      </form>
    </div></div>

    <!-- Đổi mật khẩu -->
    <div class="card border border-base-content/10 bg-base-100 shadow-sm"><div class="card-body gap-4 p-6">
      <div>
        <h2 class="font-semibold">Đổi mật khẩu</h2>
        <p class="text-sm text-base-content/60">Sau khi đổi, các thiết bị khác sẽ bị đăng xuất.</p>
      </div>
      <form id="passwordForm" class="space-y-4" novalidate>
        <input type="text" name="username" value="{{profile.email}}" autocomplete="username" class="hidden" tabindex="-1" aria-hidden="true">
        {{#if profile.hasPassword}}
        <label class="form-control w-full gap-1">
          <span class="label-text font-medium">Mật khẩu hiện tại</span>
          <input name="current" type="password" autocomplete="current-password" class="input input-bordered w-full">
        </label>
        {{/if}}
        <label class="form-control w-full gap-1">
          <span class="label-text font-medium">Mật khẩu mới</span>
          <input name="next" type="password" autocomplete="new-password" class="input input-bordered w-full">
          <span class="label-text-alt text-base-content/60">Tối thiểu 8 ký tự.</span>
        </label>
        <label class="form-control w-full gap-1">
          <span class="label-text font-medium">Nhập lại mật khẩu mới</span>
          <input name="confirm" type="password" autocomplete="new-password" class="input input-bordered w-full">
        </label>
        <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
        <div class="flex justify-end"><button type="submit" data-submit class="btn btn-primary btn-sm">Đổi mật khẩu</button></div>
      </form>
    </div></div>

  </div>
</section>
