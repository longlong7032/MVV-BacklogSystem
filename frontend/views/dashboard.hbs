{{> page_header title="Tổng quan" subtitle="Khối lượng backlog theo team và tiến độ theo dự án."}}
<div class="space-y-6">
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {{#each cards}}
    <div class="stats border border-base-content/10 bg-base-100 shadow-sm">
      <div class="stat">
        <div class="stat-title flex items-center justify-between">{{label}}<span class="h-2.5 w-2.5 rounded-full {{accent}}"></span></div>
        <div class="stat-value text-3xl">{{value}}</div>
        <div class="stat-desc whitespace-normal">{{sub}}</div>
      </div>
    </div>
    {{/each}}
  </div>

  <div class="grid gap-6 xl:grid-cols-2">
    <div class="card bg-base-100 border border-base-content/10 shadow-sm">
      <div class="flex items-center justify-between border-b border-base-content/10 px-5 py-4">
        <h2 class="text-sm font-semibold">Khối lượng theo team</h2>
        <a href="/teams" class="link link-hover text-sm font-medium">Quản lý team</a>
      </div>
      <div class="divide-y divide-base-content/10">{{> load_rows rows=teamRows empty="Chưa có team nào."}}</div>
    </div>
    <div class="card bg-base-100 border border-base-content/10 shadow-sm">
      <div class="flex items-center justify-between border-b border-base-content/10 px-5 py-4">
        <h2 class="text-sm font-semibold">Tiến độ theo dự án</h2>
        <a href="/projects" class="link link-hover text-sm font-medium">Quản lý dự án</a>
      </div>
      <div class="divide-y divide-base-content/10">{{> load_rows rows=projectRows empty="Chưa có dự án nào."}}</div>
    </div>
  </div>
</div>
