<!DOCTYPE html>
<html lang="vi" data-theme="corporate">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · Feedback backlog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.24/dist/full.min.css" rel="stylesheet" type="text/css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Giao diện dùng component + theme của DaisyUI; Tailwind chỉ dùng cho bố cục.
    // Đổi theme sáng/tối tại MỘT chỗ: hằng THEMES dưới đây (ui.ts đọc lại qua data-theme-light/-dark).
    // Khai báo màu theme DaisyUI 4 (biến CSS --p, --b1, ...) cho Tailwind CDN để các biến thể như
    // hover:bg-base-200, aria-pressed:bg-primary, bg-primary/10 được sinh ra và tự đổi theo theme sáng/tối.
    var dc = function (v) { return 'oklch(var(--' + v + ') / <alpha-value>)'; };
    tailwind.config = { theme: { extend: {
      fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
      colors: {
        primary: { DEFAULT: dc('p'), content: dc('pc') }, secondary: { DEFAULT: dc('s'), content: dc('sc') },
        accent: { DEFAULT: dc('a'), content: dc('ac') }, neutral: { DEFAULT: dc('n'), content: dc('nc') },
        'base-100': dc('b1'), 'base-200': dc('b2'), 'base-300': dc('b3'), 'base-content': dc('bc'),
        info: { DEFAULT: dc('in'), content: dc('inc') }, success: { DEFAULT: dc('su'), content: dc('suc') },
        warning: { DEFAULT: dc('wa'), content: dc('wac') }, error: { DEFAULT: dc('er'), content: dc('erc') },
      },
    } } };
    (function () {
      var THEMES = { light: 'corporate', dark: 'business' };
      var root = document.documentElement;
      root.dataset.themeLight = THEMES.light;
      root.dataset.themeDark = THEMES.dark;
      var saved = null;
      try { saved = localStorage.getItem('feedback-theme'); } catch (e) {}
      root.dataset.theme = saved === 'dark' ? THEMES.dark : THEMES.light;
    })();
  </script>
</head>

<body data-tab="{{tab}}" class="min-h-screen bg-base-200 font-sans text-base-content antialiased">
<div class="flex min-h-screen">
  <!-- ================= SIDEBAR ================= -->
  <div id="sidebarBackdrop" class="fixed inset-0 z-30 hidden bg-neutral/50 lg:hidden"></div>
  <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-base-content/10 bg-base-100 transition-transform lg:translate-x-0">
    <div class="flex h-16 items-center gap-3 border-b border-base-content/10 px-5">
      <span class="flex h-9 w-9 items-center justify-center rounded-btn bg-primary text-primary-content">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-4 3v-3a2 2 0 0 1-2-2V5Zm4 1.5a.75.75 0 0 0 0 1.5h6a.75.75 0 0 0 0-1.5H7ZM7 9a.75.75 0 0 0 0 1.5h3.5a.75.75 0 0 0 0-1.5H7Z" clip-rule="evenodd"/></svg>
      </span>
      <div class="leading-tight">
        <p class="text-sm font-semibold">Nexus IT</p>
        <p class="text-sm text-base-content/60">Project Operations</p>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto py-2" aria-label="Điều hướng">
      <ul class="menu w-full gap-0.5">
        <li class="menu-title">Tổng quan</li>
        <li><a href="/dashboard" class="{{navClass tab "dashboard"}}"{{#if (eq tab "dashboard")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M3 4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4Zm8 0a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V4ZM3 13a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3Zm8-3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-6Z"/></svg>
          Tổng quan</a></li>

        <li class="menu-title mt-2">Quản lý</li>
        <li><a href="/backlog" class="{{navClass tab "backlog"}}"{{#if (eq tab "backlog")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7.414A2 2 0 0 0 15.414 6L12 2.586A2 2 0 0 0 10.586 2H6Zm2 8a.75.75 0 0 0 0 1.5h4A.75.75 0 0 0 12 10H8Zm0 3a.75.75 0 0 0 0 1.5h4a.75.75 0 0 0 0-1.5H8Z" clip-rule="evenodd"/></svg>
          Backlog</a></li>
        <li><a href="/projects" class="{{navClass tab "projects"}}"{{#if (eq tab "projects")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M2 6a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6Z"/></svg>
          Dự án</a></li>
        <li><a href="/requirements" class="{{navClass tab "requirements"}}"{{#if (eq tab "requirements")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M5 2h7l4 4v11H5V2Zm2 5h7V6h-7v1Zm0 3h7V9h-7v1Zm0 3h5v-1H7v1Z"/></svg>
          Tài liệu PTYC</a></li>
        <li><a href="/payments" class="{{navClass tab "payments"}}"{{#if (eq tab "payments")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M2 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2H2V5Zm0 4h16v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9Zm3 4v1h4v-1H5Z"/></svg>
          Thanh toán</a></li>
        <li><a href="/teams" class="{{navClass tab "teams"}}"{{#if (eq tab "teams")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M7 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm6 1a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM1 16a6 6 0 0 1 12 0v1H1v-1Zm13 1v-1a7.97 7.97 0 0 0-1.5-4.67A5 5 0 0 1 19 16v1h-5Z"/></svg>
          Team xử lý</a></li>
        <li><a href="/people" class="{{navClass tab "people"}}"{{#if (eq tab "people")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-7 8a7 7 0 0 1 14 0v1H3v-1Z"/></svg>
          Nhân sự</a></li>

        <li class="menu-title mt-2">Tích hợp</li>
        <li><a href="/users" class="{{navClass tab "users"}}"{{#if (eq tab "users")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/></svg>
          Người dùng &amp; token</a></li>
        <li><a href="/mcp-guide" class="{{navClass tab "mcp"}}"{{#if (eq tab "mcp")}} aria-current="page"{{/if}}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.316 3.051a1 1 0 0 1 .633 1.265l-4 12a1 1 0 1 1-1.898-.632l4-12a1 1 0 0 1 1.265-.633ZM5.707 6.293a1 1 0 0 1 0 1.414L3.414 10l2.293 2.293a1 1 0 1 1-1.414 1.414l-3-3a1 1 0 0 1 0-1.414l3-3a1 1 0 0 1 1.414 0Zm8.586 0a1 1 0 0 1 1.414 0l3 3a1 1 0 0 1 0 1.414l-3 3a1 1 0 1 1-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"/></svg>
          Kết nối MCP</a></li>
      </ul>
    </nav>

    <div class="border-t border-base-content/10 px-5 py-3 text-sm text-base-content/60">Project Operations · v{{version}}</div>
  </aside>

  <!-- ================= MAIN COLUMN ================= -->
  <div class="flex min-w-0 flex-1 flex-col lg:pl-64">
    <header class="navbar sticky top-0 z-20 min-h-16 gap-3 border-b border-base-content/10 bg-base-100 px-4 sm:px-6">
      <button id="btnMenu" type="button" class="btn btn-ghost btn-sm btn-square lg:hidden" aria-label="Mở menu">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 5.75A.75.75 0 0 1 3.75 5h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 5.75Zm0 4.25a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 10Zm.75 3.5a.75.75 0 0 0 0 1.5h12.5a.75.75 0 0 0 0-1.5H3.75Z" clip-rule="evenodd"/></svg>
      </button>
      <div class="min-w-0 flex-1">
        <div class="breadcrumbs py-0 text-sm text-base-content/60">
          <ul>
            <li>Nexus IT</li>
            {{#if crumbs}}{{#each crumbs}}<li>{{#if href}}<a href="{{href}}" class="link link-hover">{{label}}</a>{{else}}<span class="max-w-[40ch] truncate font-medium text-base-content">{{label}}</span>{{/if}}</li>{{/each}}
            {{else}}<li class="font-medium text-base-content">{{title}}</li>{{/if}}
          </ul>
        </div>
      </div>
      <div class="hidden border-r border-base-content/10 pr-3 text-right sm:block" aria-label="Đồng hồ số">
        <time id="digitalClock" class="block font-mono text-base font-semibold leading-5 tabular-nums">00:00:00</time>
        <span id="digitalDate" class="mt-0.5 block text-sm leading-4 text-base-content/60"></span>
      </div>
      <button id="themeToggle" type="button" class="btn btn-ghost btn-sm" aria-label="Đổi chế độ sáng hoặc tối" aria-pressed="false"><span data-theme-icon>🌙</span><span class="hidden sm:inline" data-theme-label>Giao diện tối</span></button>
    </header>

    <main class="flex-1 px-4 py-6 sm:px-6">
{{{body}}}
    </main>
  </div>
</div>

<!-- Thông báo nhanh -->
<div id="toast" class="toast toast-end z-[1001] hidden">
  <div id="toastMsg" class="alert alert-info py-2 text-sm"></div>
</div>

<!-- Xem ảnh lớn -->
<div id="lightbox" class="fixed inset-0 z-[1000] hidden cursor-zoom-out items-center justify-center bg-neutral/80 p-4">
  <img id="lightboxImg" alt="" class="max-h-full max-w-full rounded-box shadow-2xl">
</div>

<!-- Hộp thoại xác nhận / thông báo dùng chung (thay confirm() và alert() của trình duyệt) — nằm cuối trang để luôn nằm trên các modal khác -->
<div id="dialogModal" data-modal class="modal modal-bottom z-[1002] sm:modal-middle" role="alertdialog" aria-modal="true" aria-labelledby="dialogTitle" aria-describedby="dialogMessage">
  <div class="modal-box w-full max-w-md">
    <div class="flex items-start gap-4">
      <span id="dialogIcon" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/15 text-lg font-semibold text-primary" aria-hidden="true">?</span>
      <div class="min-w-0 flex-1">
        <h2 id="dialogTitle" class="text-base font-semibold leading-snug"></h2>
        <p id="dialogMessage" class="mt-1 whitespace-pre-line break-words text-sm text-base-content/70"></p>
      </div>
    </div>
    <div class="mt-6 flex justify-end gap-2">
      <button type="button" id="dialogCancel" data-close class="btn btn-sm">Hủy</button>
      <button type="button" id="dialogConfirm" class="btn btn-primary btn-sm">Đồng ý</button>
    </div>
  </div>
</div>

<script type="module" src="/public/js/app.js"></script>
</body>

</html>
