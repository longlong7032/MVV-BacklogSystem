<!DOCTYPE html>
<html lang="vi" data-theme="corporate">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · Feedback backlog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.24/dist/full.min.css" rel="stylesheet" type="text/css">
  <link href="/public/css/app.css" rel="stylesheet">
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('feedback-theme'); } catch (e) {}
      document.documentElement.dataset.theme = saved === 'dark' ? 'business' : 'corporate';
    })();
  </script>
</head>
<body class="min-h-screen bg-base-200 font-sans antialiased">
<main class="flex min-h-screen items-center justify-center px-4 py-10">
  <div class="w-full max-w-sm">
    <div class="mb-6 flex items-center justify-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-content">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-4 3v-3a2 2 0 0 1-2-2V5Zm4 1.5a.75.75 0 0 0 0 1.5h6a.75.75 0 0 0 0-1.5H7ZM7 9a.75.75 0 0 0 0 1.5h3.5a.75.75 0 0 0 0-1.5H7Z" clip-rule="evenodd"/></svg>
      </span>
      <div class="leading-tight">
        <p class="text-base font-semibold">Nexus IT</p>
        <p class="text-sm opacity-60">Project Operations</p>
      </div>
    </div>

{{#if (eq state "disabled")}}
    <div role="alert" class="flex flex-col gap-0 rounded-box border border-base-content/10 bg-base-100 p-5 text-sm shadow-sm">
      <p class="font-semibold">Chưa có quản trị viên nào</p>
      <p class="mt-1">Tài khoản nằm trong cơ sở dữ liệu. Chạy lệnh sau trên máy chủ chứa ứng dụng để tạo quản trị viên đầu tiên (mật khẩu tối thiểu 8 ký tự):</p>
      <div class="mockup-code mt-2 w-full overflow-x-auto text-sm"><pre data-prefix="$"><code>npm run create-admin -- "Họ tên" email@congty.vn "mật-khẩu"</code></pre></div>
      <a href="/login" class="btn btn-primary btn-sm mt-4">Tôi đã tạo, tải lại</a>
    </div>
{{else}}
    <div class="card border border-base-content/10 bg-base-100 shadow-sm"><div class="card-body">
      <h1 class="text-lg font-semibold">Đăng nhập</h1>
      <p class="mt-1 text-sm opacity-70">Đăng nhập quản trị viên để quản lý người dùng.</p>
      <form id="adminKeyForm" data-login data-next="{{next}}" class="mt-4 space-y-3" novalidate>
        <div id="loginPasswordFields" class="space-y-3">
          <input id="adminEmail" name="email" type="email" autocomplete="username" inputmode="email" placeholder="Email quản trị" autofocus
            class="input input-bordered w-full">
          <input id="adminPassword" name="password" type="password" autocomplete="current-password" placeholder="Mật khẩu"
            class="input input-bordered w-full">
        </div>
        <p data-error role="alert" class="alert alert-error hidden py-2 text-sm"></p>
        <button type="submit" data-submit class="btn btn-primary btn-block">Đăng nhập</button>
      </form>
    </div></div>
{{/if}}
    <p class="mt-6 text-center text-sm opacity-50">v{{version}}</p>
  </div>
</main>
<script type="module" src="/public/js/login.js"></script>
</body>
</html>
