{
  "name": "feedback-backlog-frontend",
  "version": "2.0.0",
  "description": "Feedback backlog — Frontend: server render giao diện bằng Handlebars, gọi Backend qua HTTP. TypeScript + Express.",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client && npm run build:css",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/server.js",
    "dev": "npm run build:client && npm run build:css && tsx watch --include \"views/**/*.hbs\" src/server.ts",
    "vercel-build": "npm run build",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/app.css -o public/css/app.css --minify"
  },
  "dependencies": {
    "@types/express": "^4.17.25",
    "@types/hbs": "^4.0.5",
    "@types/node": "^22.20.5",
    "express": "^4.19.2",
    "hbs": "^4.2.0",
    "http-proxy-middleware": "^3.0.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15"
  }
}
