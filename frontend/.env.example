# Cấu hình FRONTEND — file này không nên commit khi có giá trị thật.

# Cổng chạy frontend
PORT=3000

# Địa chỉ backend (API + MCP + file tải lên). Frontend gọi tới đây và proxy /api, /uploads, /mcp.
BACKEND_URL=http://localhost:4000

# Số proxy phía trước frontend. 0 = chạy trực tiếp (local); 1 = sau nginx / load balancer / Vercel.
TRUST_PROXY=1

# Địa chỉ công khai của frontend, dùng dựng URL MCP ở trang hướng dẫn. Bỏ trống = tự lấy theo request.
# PUBLIC_URL=https://backlog.congty.vn
