          <div>
            <p class="mb-1.5 text-sm font-medium text-slate-700">Team xử lý</p>
            <div id="teamChips" class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1"></div>
            <select id="fTeam" class="hidden" tabindex="-1" aria-hidden="true"></select>
          </div>

          <div>
            <p class="mb-1.5 text-sm font-medium text-slate-700">Trạng thái</p>
            <div id="statusChips" class="grid grid-cols-3 gap-2"></div>
            <select id="fStatus" class="hidden" tabindex="-1" aria-hidden="true"></select>
          </div>
        </div>
      </details>

      <div>
        <label for="fTitle" class="mb-1.5 block text-sm font-medium text-slate-700">Tên lỗi</label>
        <input id="fTitle" maxlength="200" autocomplete="off" enterkeyhint="next" placeholder="Tóm tắt ngắn gọn lỗi"
          class="w-full rounded-lg border border-slate-300 px-3 py-3 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:py-2.5 sm:text-sm">
      </div>

      <section data-zone="location" class="-m-2 rounded-lg border border-transparent p-2">
        <label for="fLocationUrl" class="mb-1.5 block text-sm font-medium text-slate-700">Vị trí lỗi <span class="font-normal text-slate-500">(URL hoặc ảnh)</span></label>
        <input id="fLocationUrl" name="location_url" type="text" inputmode="url" placeholder="https://..." autocomplete="off" autocapitalize="off"
          class="w-full rounded-lg border border-slate-300 px-3 py-3 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:py-2.5 sm:text-sm">
        <div data-dropzone="location" class="mt-2 flex flex-wrap items-center gap-2 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-2">
          <button type="button" data-pick="location" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700 hover:bg-slate-100 sm:min-h-0 sm:py-1.5">
            <span aria-hidden="true">📷</span> Thêm ảnh
          </button>
          <span class="hidden text-sm text-slate-500 sm:inline">hoặc kéo thả / dán ảnh (Ctrl+V)</span>
          <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="hidden" data-input="location">
          <div data-preview="location" class="flex w-full flex-wrap gap-2 empty:hidden"></div>
        </div>
        <div id="fHarBox" class="mt-2 hidden items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm">
          <a id="fHarLink" href="#" download class="truncate text-indigo-600 underline hover:text-indigo-800"></a>
          <label class="flex shrink-0 items-center gap-1.5 text-slate-600">
            <input type="checkbox" id="fRemoveHar" class="h-4 w-4 rounded border-slate-300"> Gỡ HAR
          </label>
        </div>
      </section>

      <section data-zone="bug" class="-m-2 rounded-lg border border-transparent p-2">
        <label for="fBugText" class="mb-1.5 block text-sm font-medium text-slate-700">Mô tả lỗi <span class="font-normal text-slate-500">(ảnh + text)</span></label>
        <textarea id="fBugText" name="bug_text" rows="3"
          class="w-full rounded-lg border border-slate-300 px-3 py-3 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:py-2.5 sm:text-sm"></textarea>
        <div data-dropzone="bug" class="mt-2 flex flex-wrap items-center gap-2 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-2">
          <button type="button" data-pick="bug" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700 hover:bg-slate-100 sm:min-h-0 sm:py-1.5">
            <span aria-hidden="true">📷</span> Thêm ảnh
          </button>
          <span class="hidden text-sm text-slate-500 sm:inline">hoặc kéo thả / dán ảnh (Ctrl+V)</span>
          <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple class="hidden" data-input="bug">
          <div data-preview="bug" class="flex w-full flex-wrap gap-2 empty:hidden"></div>
        </div>
      </section>

      <section data-zone="expected" class="-m-2 rounded-lg border border-transparent p-2">
        <label for="fExpectedText" class="mb-1.5 block text-sm font-medium text-slate-700">Kết quả mong muốn <span class="font-normal text-slate-500">(ảnh + text)</span></label>
        <textarea id="fExpectedText" name="expected_text" rows="2"
          class="w-full rounded-lg border border-slate-300 px-3 py-3 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:py-2.5 sm:text-sm"></textarea>
        <div data-dropzone="expected" class="mt-2 flex flex-wrap items-center gap-2 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-2">
          <button type="button" data-pick="expected" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700 hover:bg-slate-100 sm:min-h-0 sm:py-1.5">
            <span aria-hidden="true">📷</span> Thêm ảnh
          </button>
          <span class="hidden text-sm text-slate-500 sm:inline">hoặc kéo thả / dán ảnh (Ctrl+V)</span>
          <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple class="hidden" data-input="expected">
          <div data-preview="expected" class="flex w-full flex-wrap gap-2 empty:hidden"></div>
        </div>
      </section>

      <details id="fNoteBox" class="group">
        <summary class="cursor-pointer list-none py-1 [&::-webkit-details-marker]:hidden text-sm font-medium text-indigo-600 hover:text-indigo-800 group-open:hidden">+ Thêm ghi chú</summary>
        <label for="fNote" class="mb-1.5 block text-sm font-medium text-slate-700">Ghi chú <span class="font-normal text-slate-500">(nếu có)</span></label>
        <textarea id="fNote" rows="2"
          class="w-full rounded-lg border border-slate-300 px-3 py-3 text-base focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:py-2.5 sm:text-sm"></textarea>
      </details>

      <p id="formError" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></p>
    </div>

    <!-- Thanh nút luôn hiển thị ở đáy -->
    <div class="flex shrink-0 gap-2 border-t border-slate-200 bg-white px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:justify-end sm:bg-slate-50 sm:px-5">
      <button id="btnSave" type="submit" class="order-3 min-h-[48px] flex-1 rounded-lg bg-indigo-600 px-5 text-base font-semibold text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60 sm:min-h-0 sm:flex-none sm:py-2 sm:text-sm sm:font-medium">Lưu</button>
      <button id="btnSaveNew" type="submit" class="order-2 min-h-[48px] flex-1 rounded-lg border border-indigo-200 bg-indigo-50 px-3 text-sm font-semibold text-indigo-700 hover:bg-indigo-100 disabled:cursor-not-allowed disabled:opacity-60 sm:min-h-0 sm:flex-none sm:py-2 sm:font-medium">Lưu &amp; thêm tiếp</button>
      <button type="button" data-close class="order-1 hidden rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 sm:inline-flex">Hủy</button>
    </div>
  </form>
</div>

