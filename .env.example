# Cấu hình Feedback backlog — file này chứa bí mật, KHÔNG commit (đã có trong .gitignore)

PORT=3000

# Số proxy phía trước app. 0 = chạy trực tiếp (local); 1 = sau nginx / load balancer.
TRUST_PROXY=1

# Địa chỉ công khai của web app (dùng dựng link ảnh / HAR trong MCP). Bỏ trống = tự lấy theo request.
# PUBLIC_URL=https://backlog.congty.vn

# Ép toàn server chỉ đọc qua MCP (bỏ qua quyền từng người dùng).
# MCP_READONLY=1

# CHỈ để thử local: bỏ xác thực trang Người dùng và /mcp. KHÔNG bật khi deploy.
# DEV_NO_AUTH=1
