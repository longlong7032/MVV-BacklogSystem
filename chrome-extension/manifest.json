{
  "manifest_version": 3,
  "name": "Feedback backlog – Báo lỗi nhanh",
  "version": "1.0.0",
  "description": "Mở form báo lỗi ngay trên trang đang test, tự chụp màn hình và gửi kèm file HAR (tuỳ chọn) lên Feedback backlog.",
  "permissions": ["storage", "tabs", "activeTab", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "devtools_page": "devtools.html",
  "action": {
    "default_title": "Báo lỗi (Alt+Shift+B)",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B", "mac": "Alt+Shift+B" },
      "description": "Mở form báo lỗi"
    }
  }
}
