{
  // Giao diện trình duyệt: client/app.ts  ->  public/js/app.js (nạp bằng <script type="module">)
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "client",
    "outDir": "public/js"
  },
  "include": ["client/**/*.ts", "shared/**/*.d.ts"]
}
