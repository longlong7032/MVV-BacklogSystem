{
  // Extension Chrome: chrome-extension/src/*.ts  ->  chrome-extension/*.js (nạp bằng type="module")
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "rootDir": "chrome-extension/src",
    "outDir": "chrome-extension"
  },
  "include": ["chrome-extension/src/**/*.ts", "shared/**/*.d.ts"],
  "exclude": [] // mặc định tsc loại thư mục outDir (chứa cả src/) khỏi include nên phải khai báo rỗng
}
